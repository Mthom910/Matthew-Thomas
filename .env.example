# Copy this file to .env and fill in real values. .env is never committed.
#
# Insyte OData v2 API credentials (Basic auth: email + API key).
# These currently only grant access to Victory Curtains & Blinds data —
# Wynstan appears to live on a separate Insyte tenant. If you have separate
# Wynstan credentials, add INSYTE_WYNSTAN_* equivalents and see the README.

INSYTE_BASE_URL=https://api.myinsyte.com.au/v2
INSYTE_EMAIL=you@example.com
INSYTE_API_KEY=replace-with-real-key
